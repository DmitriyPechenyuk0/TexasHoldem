# API configuration, validated at startup by src/shared/infrastructure/config.
#
# Local setup: `cp .env.example .env`. The values below match the services started by `pnpm infra:up`.
# Real environment variables take precedence over `.env`, and empty values count as unset.

# --- Runtime -----------------------------------------------------------------

# development | test | production. Default: development.
NODE_ENV=development
# HTTP port. Default: 4000.
PORT=4000
# trace | debug | info | warn | error | fatal | silent. Default: debug in development, info otherwise.
# Development prints readable lines; every other NODE_ENV prints one JSON object per line.
LOG_LEVEL=
# Proxies in front of the api whose X-Forwarded-For is trusted for the client address: false (default,
# clients connect directly), true (any), a number of hops such as 1, or addresses and subnets such as
# `loopback, 10.0.0.0/8`. Set it behind a load balancer, or every client shares the proxy's address.
TRUST_PROXY=
# Origin of the web app (scheme, host and port; no path or trailing slash). Used for CORS and auth redirects.
WEB_ORIGIN=http://localhost:3000

# --- Data stores -------------------------------------------------------------

# PostgreSQL connection string, postgres:// or postgresql://. Used by the app and drizzle-kit (pnpm db:*).
# Tests never read .env: they take the server from this file and create a holdem_test_* database per test file.
DATABASE_URL=postgres://holdem:holdem@127.0.0.1:5433/holdem
# Redis connection string, redis:// or rediss:// for TLS.
REDIS_URL=redis://127.0.0.1:6379

# --- Email -------------------------------------------------------------------

# SMTP server. Locally this is Mailpit, with its inbox at http://localhost:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# true for implicit TLS (usually port 465); false upgrades with STARTTLS when the server offers it. Default: false.
SMTP_SECURE=false
# SMTP credentials: set both or neither. Mailpit needs none.
SMTP_USER=
SMTP_PASSWORD=
# Sender address of every outgoing email.
SMTP_FROM="Hold'em <no-reply@holdem.local>"

# --- Object storage ----------------------------------------------------------

# S3-compatible endpoint. Locally this is RustFS, with its console at http://localhost:9001.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=holdem
S3_SECRET_ACCESS_KEY=holdem-dev-secret
# Bucket for user avatars; objects are publicly readable, listing is not.
S3_BUCKET=avatars
# true for path-style URLs (RustFS, MinIO); false for virtual-hosted buckets (AWS S3). Default: false.
S3_FORCE_PATH_STYLE=true

# --- Authentication ----------------------------------------------------------

# Signs sessions and tokens; at least 32 characters. This value is for local development only:
# generate a real one with `openssl rand -base64 32`.
AUTH_SECRET=local-development-only-secret-0123456789
# OAuth apps, all optional. A provider is enabled only when both its client id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
