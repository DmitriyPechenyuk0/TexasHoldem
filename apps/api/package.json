{
	"name": "@holdem/api",
	"version": "0.0.1",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"dev": "nest start --watch --env-file .env",
		"build": "nest build",
		"start": "nest start --env-file .env",
		"start:debug": "nest start --debug --watch --env-file .env",
		"start:prod": "node --env-file-if-exists=.env dist/main",
		"lint": "oxlint --type-aware src/ test/ && pnpm run lint:deps",
		"lint:deps": "depcruise src test --output-type err-long",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@holdem/engine": "workspace:*",
		"@holdem/shared": "workspace:*",
		"@nestjs/common": "^12.2.0",
		"@nestjs/core": "^12.2.0",
		"@nestjs/cqrs": "^12.1.1",
		"@nestjs/platform-express": "^12.2.0",
		"@nestjs/platform-socket.io": "^12.2.0",
		"@nestjs/websockets": "^12.2.0",
		"drizzle-orm": "1.0.0-rc.5",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.9",
		"@nestjs/schematics": "^12.0.9",
		"@nestjs/testing": "^12.2.0",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.0.5",
		"dependency-cruiser": "^18.7.0",
		"drizzle-kit": "1.0.0-rc.5",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2004",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	}
}
