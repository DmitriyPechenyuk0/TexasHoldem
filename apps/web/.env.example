# Web configuration, validated at server startup by src/shared/config.
#
# Local setup: `cp .env.example .env`. The values below match the API started with `pnpm dev`.
# Real environment variables take precedence over `.env` files, and empty values count as unset.
# Next.js expands `$NAME` references in these files; escape a literal dollar sign as `\$`.

# --- Public (inlined into the browser bundle at build time) ------------------
# Never put secrets here, and rebuild after changing a value.

# Base URL of the API as the browser reaches it.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Server only -------------------------------------------------------------

# Base URL of the API for server-side requests (Server Components, Route Handlers).
# Usually the same as NEXT_PUBLIC_API_URL locally; can be an internal address in production.
API_URL=http://localhost:4000
